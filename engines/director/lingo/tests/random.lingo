-- random() takes one or TWO arguments. The lexicon describes the one-argument
-- form alone and writes a range as random(16) + 4 (D8 Demystified, p. 1001),
-- but the games call it with two all the same: 162 call sites in the corpus,
-- and one Loewenzahn 8 run reaches them 2615 times.
--
-- Everything asserted below was measured in Director 7.0.2 and in Director
-- 8.5.1 (the Lingo engine Director MX carries), 400 draws per case, and the two
-- answered alike line for line -- hence no version gate. Numbers in
-- random-results.md.
--
-- randomSpread() is the probe that took those measurements. To re-measure in
-- Director, paste it into a MOVIE script, strip every comment and save with CR
-- line endings, or Director will not take it.

on randomSpread caption, a, b, two
  set mn = 1000000
  set mx = -1000000
  set seen = []
  set nseen = 0
  repeat with i = 1 to 400
    if two = 1 then
      set v = random(a, b)
    else
      set v = random(a)
    end if
    if v < mn then
      set mn = v
    end if
    if v > mx then
      set mx = v
    end if
    if getPos(seen, v) = 0 then
      append(seen, v)
      set nseen = nseen + 1
    end if
  end repeat
  put caption && "min" && mn && "max" && mx && "distinct" && nseen
  return [mn, mx, nseen]
end

-- One argument, positive: uniform over 1..a, both ends included. random(3) is
-- the control the Director runs carried: a case whose answer nobody disputes,
-- so a run that gets it wrong is measuring something other than random().
set r = randomSpread("random(3) control", 3, 0, 0)
scummvmAssertEqual(getAt(r, 1), 1)
scummvmAssertEqual(getAt(r, 2), 3)
scummvmAssertEqual(getAt(r, 3), 3)

set r = randomSpread("random(5)", 5, 0, 0)
scummvmAssertEqual(getAt(r, 1), 1)
scummvmAssertEqual(getAt(r, 2), 5)
scummvmAssertEqual(getAt(r, 3), 5)

-- Two arguments, the second above the first: uniform over a..b, and BOTH ends
-- come up. random(12, 14) answers 12, 13 and 14.
set r = randomSpread("random(12, 14)", 12, 14, 1)
scummvmAssertEqual(getAt(r, 1), 12)
scummvmAssertEqual(getAt(r, 2), 14)
scummvmAssertEqual(getAt(r, 3), 3)

-- The lower end may be zero, and it may be negative. The corpus does both:
-- random(-3, 3) at six call sites, random(-1, 1) at two.
set r = randomSpread("random(0, 1)", 0, 1, 1)
scummvmAssertEqual(getAt(r, 1), 0)
scummvmAssertEqual(getAt(r, 2), 1)
scummvmAssertEqual(getAt(r, 3), 2)

set r = randomSpread("random(-3, 3)", -3, 3, 1)
scummvmAssertEqual(getAt(r, 1), -3)
scummvmAssertEqual(getAt(r, 2), 3)
scummvmAssertEqual(getAt(r, 3), 7)

set r = randomSpread("random(-1, 1)", -1, 1, 1)
scummvmAssertEqual(getAt(r, 1), -1)
scummvmAssertEqual(getAt(r, 2), 1)
scummvmAssertEqual(getAt(r, 3), 3)

-- Both ends below zero, and a span that straddles it. Nothing special happens
-- at zero: the span is to - from + 1 wherever it sits.
set r = randomSpread("random(-10, -5)", -10, -5, 1)
scummvmAssertEqual(getAt(r, 1), -10)
scummvmAssertEqual(getAt(r, 2), -5)
scummvmAssertEqual(getAt(r, 3), 6)

set r = randomSpread("random(-10, 0)", -10, 0, 1)
scummvmAssertEqual(getAt(r, 1), -10)
scummvmAssertEqual(getAt(r, 2), 0)
scummvmAssertEqual(getAt(r, 3), 11)

set r = randomSpread("random(0, 5)", 0, 5, 1)
scummvmAssertEqual(getAt(r, 1), 0)
scummvmAssertEqual(getAt(r, 2), 5)
scummvmAssertEqual(getAt(r, 3), 6)

-- The second argument only counts while it is ABOVE the first. These two drop
-- back on the one-argument form: Director neither pins the result to the bound
-- nor swaps the ends, so random(5, 5) answers 1..5 and random(14, 12) 1..14.
set r = randomSpread("random(5, 5)", 5, 5, 1)
scummvmAssertEqual(getAt(r, 1), 1)
scummvmAssertEqual(getAt(r, 2), 5)
scummvmAssertEqual(getAt(r, 3), 5)

set r = randomSpread("random(14, 12)", 14, 12, 1)
scummvmAssertEqual(getAt(r, 1), 1)
scummvmAssertEqual(getAt(r, 2), 14)
scummvmAssertEqual(getAt(r, 3), 14)

-- random(a) with a <= 0 is UNDEFINED in Director: 7.0.2 and 8.5.1 both hand
-- back uninitialised memory, scattered over the whole signed 32-bit range (400
-- distinct values in 400 draws, -2145681433 to 2146289312). A movie asking for
-- a random number up to zero has already lost its footing, so ScummVM answers
-- something bounded instead and only the bound is asserted here.
set r = randomSpread("random(0)", 0, 0, 0)
scummvmAssertEqual(getAt(r, 1) >= 1, 1)
scummvmAssertEqual(getAt(r, 2) <= 65535, 1)

set r = randomSpread("random(0, 0)", 0, 0, 1)
scummvmAssertEqual(getAt(r, 1) >= 1, 1)
scummvmAssertEqual(getAt(r, 2) <= 65535, 1)

set r = randomSpread("random(-3)", -3, 0, 0)
scummvmAssertEqual(getAt(r, 1) >= 1, 1)
scummvmAssertEqual(getAt(r, 2) <= 65535, 1)

-- The answer is an integer in both forms.
scummvmAssertEqual(ilk(random(10)), #integer)
scummvmAssertEqual(ilk(random(2, 4)), #integer)

-- Both Directors answered alike, so the rule carries no version gate. These two
-- runs pin that down rather than leaving it to the comment above.
set save = the scummvmVersion

set the scummvmVersion to 700
set r = randomSpread("random(12, 14) at 700", 12, 14, 1)
scummvmAssertEqual(getAt(r, 1), 12)
scummvmAssertEqual(getAt(r, 2), 14)
scummvmAssertEqual(getAt(r, 3), 3)

set the scummvmVersion to 900
set r = randomSpread("random(12, 14) at 900", 12, 14, 1)
scummvmAssertEqual(getAt(r, 1), 12)
scummvmAssertEqual(getAt(r, 2), 14)
scummvmAssertEqual(getAt(r, 3), 3)

set the scummvmVersion to save
