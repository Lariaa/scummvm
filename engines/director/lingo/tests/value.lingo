
-- int
scummvmAssertEqual(55, value("55"))
-- float
scummvmAssertEqual(5.55, value("5.55"))
-- array
scummvmAssertEqual([1, 2, 3], value("[1, 2, 3]"))
-- parray
scummvmAssertEqual([#a: 1, #b: 2], value("[#a: 1, #b: 2]"))
-- member references, as serialised into behavior initializer parameters;
-- the member() builtin only exists from D5 on
set the scummvmVersion to 500
scummvmAssertEqual([#alternateImage: member(2, 3)], value("[#alternateImage: (member 2 of castLib 3)]"))
set the scummvmVersion to 400

-- expressions
scummvmAssertEqual(9, value("3*3"))

-- empty line is special
scummvmAssertEqual(Void, value(""))

-- simple expressions with garbage
scummvmAssertEqual(55, value("55 5"))
scummvmAssertEqual(55, value("55 abra"))
scummvmAssertEqual(12, value("12 PM"))

-- simple string
set test = QUOTE & "abra" & QUOTE
scummvmAssertEqual("abra", value(test))

-- string with garbage
set test = QUOTE & "abra" & QUOTE & " 55"
scummvmAssertEqual("abra", value(test))

-- broken string
set test = QUOTE & "abra"
scummvmAssertEqual("Void, value(test))

-- string, starting expression
set test = QUOTE & "abra" & QUOTE & " & " & QUOTE & "kadabra" & QUOTE
scummvmAssertEqual("abrakadabra", value(test))

-- equality operator
scummvmAssertEqual(1, value("5=5"))
scummvmAssertEqual(0, value("5=2"))
scummvmAssertEqual(1, value("0.500=0.500"))
scummvmAssertEqual(0, value("0.500=2.500"))

-- the kicker; you are allowed to have garbage on the end!!!
-- if it hits a token it doesn't understand, the parser should try again but stopping just before that token.
scummvmNoFatalError(true)

scummvmAssertEqual(9, value("3*3[34]"))
scummvmAssertEqual([1, 2, 3], value("[1, 2, 3],4]"))

scummvmNoFatalError(false)

-- if there's no valid expression at all, return void
set test = value("#")
scummvmAssert(voidP(test))

-- From D8 on a backslash ending a line continues the statement on the next
-- one. TKKG 13 and 14 keep each scene's sound play list in a text member,
-- one entry per line, and read it with value(member("playlist").text).
-- The results are compared back at the default version, because the
-- string-equality tables stop at D6 (see xtralist.lingo).
set savedVer to the scummvmVersion
set the scummvmVersion to 800
set test = "[#a: [1, 2]," & "\" & RETURN & "#b: 3]"
set continued = value(test)
set the scummvmVersion to 700
scummvmNoFatalError(true)
set notContinued = value(test)
scummvmNoFatalError(false)
set the scummvmVersion to savedVer
scummvmAssertEqual([#a: [1, 2], #b: 3], continued)
scummvmAssert(not listP(notContinued))
