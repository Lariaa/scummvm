
on count l
  return "what is this"
end

on add l, x
  return "this is the worst"
end

on getLast l
  return "overridden getLast"
end

set result = count([1, 2, 3])
scummvmAssertEqual(result, 3)

set result = count([1: 2, 3: 4, 5: 6])
scummvmAssertEqual(result, 3)

set result = count(rect(1, 2, 3, 4))
scummvmAssertEqual(result, 4)

set result = count(point(1, 2))
scummvmAssertEqual(result, 2)

set result = count("not an array")
scummvmAssertEqual(result, "what is this")

set result = add("still not an array")
scummvmAssertEqual(result, "this is the worst")

set result = add("even less of an array", 8)
scummvmAssertEqual(result, "this is the worst")

set target = [1, 2, 3]
add(target, 4)
scummvmAssertEqual(count(target), 4)

-- Real-world combined case from "Ein Fall fuer Muetze & Co" (SpecialAddresses
-- parent script): it defines "on getLast me" yet calls getLast(MovieRef, 2)
-- where MovieRef is a list, e.g. ["IN_OUT", "LINTRANS"]. Two fixes must combine:
-- the list builtin wins over the same-named handler, AND the surplus 2nd
-- argument is dropped -- so the result is the list's last element, used to build
-- the member name "Special" & <last> & "Addresses".
set result = getLast(["IN_OUT", "LINTRANS"], 2)
scummvmAssertEqual(result, "LINTRANS")

-- A non-list argument still falls back to the user-defined handler.
set result = getLast("not a list")
scummvmAssertEqual(result, "overridden getLast")

-- The builtin also has to win over a same-named method of the object we are
-- calling from. That is the shape "Ein Fall fuer Muetze & Co" actually uses:
-- its SpecialAddresses parent script defines "on getLast me" and still calls
-- getLast(MovieRef, 2) on a list from its own "new" method. Resolving that to
-- the local method left the object uninitialized.
set obj = ListOverrideFactory(mNew)
scummvmAssertEqual obj(mListResult) "LINTRANS"

-- ...while a non-list argument still reaches the object's own method.
scummvmAssertEqual obj(mPlainResult) "method getLast"

--
factory ListOverrideFactory
method mNew
    instance listResult, plainResult
    set listResult = getLast(["IN_OUT", "LINTRANS"], 2)
    set plainResult = getLast("not a list")
method getLast
    return "method getLast"
method mListResult
    return listResult
method mPlainResult
    return plainResult

